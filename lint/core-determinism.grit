`Math.$method` as $ref where {
    $method <: or { `random`, `sin`, `cos`, `tan`, `asin`, `acos`, `atan`, `atan2`, `sinh`, `cosh`, `tanh`, `asinh`, `acosh`, `atanh`, `exp`, `expm1`, `log`, `log1p`, `log2`, `log10`, `pow`, `cbrt`, `hypot` },
    register_diagnostic(
        span = $ref,
        message = "Core must stay deterministic across browsers: no Math.random or implementation-dependent Math functions. Use seeded RNG or integer/fixed-point math."
    )
}
